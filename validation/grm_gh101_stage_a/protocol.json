  "pilot_reuse": {
    "allowed": false,
    "reason": "Pilot numpy2.4.6/scipy1.17.1/pandas3.1.0/Python3.11 differs from current runtime; current runner omits old-GH61 diagnostic calculations. Strict identity condition fails. Refit all200; no pilot estimates pooled. Preserve and hash archived matrices/ordinal outcomes; verify reconstructed data hashes."
  },
  "data": "Unchanged gen_ordinal N500/500 J10 C4 latent no-DIF a=linspace(.9,1.8,10), thresholds=linspace(-1,1,10)+[-1,0,1]. Seeds fixed first100 original family. Reconstruct common two normal+ten uniform draws for impacts -.5/0, validate both archived per-seed data hashes before fitting; persist matrices and draw hashes. Seed equality alone insufficient. No old GH61 MC calibration/refits. Reuse ordinal total/rest decisions ONLY with matching seed/impact/data hash; missing/invalid ordinal decisions remain missing, never recomputed.",
  "model": "Unchanged core.grm_dif; P01-P08 oracle invariant anchors; P09/P10 tested; reference N(0,1); focal mean/logSD free. Slopes positive [.1,4], thresholds ordered b0[-6,4], log gaps[log(.05),log6], focal mu[-3,3],logSD[log(.3),log3]. Seven unique hypotheses/eight slots; H2 shared once. df omnibus4/thresholds3/slope1.",
  "optimization": "Every unique hypothesis G.Fitter.fit(start_fit=None,information=True,max_iter=2000), fresh per-dataset fitter; uniform native NumPy GH101. L-BFGS-B maxiter2000 ftol1e-14 gtol1e-10 unchanged. Capture actual x0 and independently reconstruct pooled-category a1/mu0/SD1 start. No warm starts, retries, substitution, rescue/density escalation, or alternate seeds.",
  "audit": "Unchanged pilot arithmetic: SciPy roots_hermitenorm GH161; direct-row logLik at101/161, normalized gradient at161, all-coordinate independent direct-row central differences h1e-4 and1e-5*max(1,abs(p)), dense GH161 observed information (analytic-gradient differences), anchor/physical bounds and LR checks. Independent post-run reader verifies raw hashes, actual starts, source hashes, likelihoods, gradients/information/LR and statistical calculations without optimization.",
  "gates": {
    "native_score_strict_lt": 0.000002,
    "audit_score_lte": 0.00001,
    "absolute_loglik_grid_error_lte": 0.001,
    "bound_distance_gte": 0.0001,
    "information": "finite covariance; native and GH161 dense minEigen>1e-7*max(maxEigen,1)",
    "fd_atol": 1e-8,
    "fd_rtol": 0.00001,
    "lr": "Unchanged native _nested_lr; exact df4/3/1 and anchors, positive ordered thresholds. LR fit/audit .004 is implied per-fit bound, not loosened gate."
  },
  "decisions": "Validation-only p=chi2.sf(LR_GH161_at_GH101_solution,df); GH101 LR/p retained as sensitivity diagnostics. Per dataset primary omnibus P09/P10 family m=2: Holm(alpha=.05) FWER and BH(q=.05). Threshold and slope families m=2 each separately descriptive; not a common six-test FWER guarantee. If any scientific gate fails, dataset GRM family p/decisions suppressed (null), not zero. No production suppression change.",
  "statistics": "Primary operational false-DIF rates conditional on valid complete dataset family, against global latent-null DGP. BH P(any rejection)=FDR only under this global null. Raw rejection count/2 reported with seed-clustered sample SD/sqrt(n) MCSE. Bernoulli MCSE sample SD/sqrt(n), null for n<2. CP95 marginal and CP97.5 for two rate intervals; paired differences sample SD/sqrt(n). Never interpret 1400 fitted hypotheses as 1400 independent replications.",
  "contrasts": {
    "binary": [
      "GRM-minus-total_minus",
      "GRM-minus-rest_minus",
      "GRM-minus-total_zero",
      "GRM-minus-rest_zero",
      "GRM_zero-minus-minus",
      "total-minus-rest_minus",
      "total-minus-rest_zero"
    ],
    "interactions": [
      "(GRM-total)_zero-minus-minus",
      "(GRM-rest)_zero-minus-minus"
    ],
    "pairing": "Each contrast uses only identical seeds with all constituent valid data/decisions; impact pairs and interactions require common random draw/data evidence. Record n, missing and discordant/16-cell tables.",
    "intervals": "Conservative exact paired95 via CP bounds on discordance and direction, each alpha=.025. Hoeffding marginal95 for D width2 and W width4. Joint11-component family: two GRM FWER CP intervals and nine contrast Hoeffding intervals, each alpha=.05/11. Exact interaction95 uses subtraction of two97.5% paired intervals (union bound). Seven binary McNemar exact two-sided raw and Holm7/BH7 adjusted p; not for interactions. All are scoped/descriptive StageA, no nominal-control certification."
